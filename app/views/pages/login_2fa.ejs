<!DOCTYPE html>
<html lang="<%= locals.htmlLang || 'pt-BR' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <title><%= t('auth.login2fa_seo_titulo') %></title>
  <link rel="stylesheet" href="/css/reservas.css">
  <link rel="stylesheet" href="/css/recuperacao.css">
  <script src="/js/theme.js"></script>
</head>
<body>
<%- include('../partials/header') %>
<main id="main-content" class="booking-main">
  <div class="container">
    <div class="auth-card">
      <h1><%= t('auth.duas_etapas') %></h1>
      <p class="booking-sub"><%= t('auth.login2fa_instrucao') %></p>
      <% if (error) { %><p class="form-alert form-alert-error" role="alert"><%= tm(error) %></p><% } %>
      <form action="/login/2fa" method="POST" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="codigo"><%= t('auth.codigo_label') %></label>
        <%# one-time-code: o celular sugere o código; numeric abre o teclado numérico. %>
        <input type="text" id="codigo" name="codigo" inputmode="numeric" autocomplete="one-time-code"
               maxlength="11" required autofocus placeholder="000000" class="code-input">
        <button type="submit" class="btn-primary btn-block"><%= t('auth.confirmar') %></button>
      </form>
      <details class="auth-note">
        <summary><%= t('auth.perdi_celular') %></summary>
        <%- t('auth.perdi_celular_texto_html') %>
      </details>
      <p class="auth-links"><a href="/login"><%= t('auth.voltar_login') %></a></p>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
</body>
</html>
