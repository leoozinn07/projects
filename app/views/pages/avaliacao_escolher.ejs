<!DOCTYPE html>
<html lang="<%= locals.htmlLang || 'pt-BR' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <title><%= t('avaliacao.escolher_seo_titulo') %></title>
  <link rel="stylesheet" href="/css/reservas.css">
  <script src="/js/theme.js"></script>
</head>
<body>
<%- include('../partials/header') %>
<main id="main-content" class="booking-main">
  <div class="container">
    <h1><%= t('avaliacao.escolher_titulo') %></h1>
    <% if (!lista.length) { %>
      <p class="booking-sub">
        <%= t('avaliacao.escolher_vazio') %>
      </p>
      <a class="btn-ghost" href="/minhas-reservas"><%= t('reservas.titulo') %></a>
    <% } else { %>
      <p class="booking-sub"><%= t('avaliacao.escolher_escolha') %></p>
      <ul class="booking-list">
        <% lista.forEach(function (b) { %>
          <li class="booking-item">
            <h2><%= b.title %></h2>
            <p class="meta"><%= t('avaliacao.escolher_realizada_em', { data: fmt.data(b.starts_at) }) %></p>
            <div class="booking-actions"><a class="btn-primary" href="/avaliacao/<%= b.booking_id %>"><%= t('avaliacao.escolher_avaliar_btn') %></a></div>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</main>
<%- include('../partials/footer') %>
</body>
</html>
