<!DOCTYPE html>
<html lang="<%= locals.htmlLang || 'pt-BR' %>">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover"/>
  <meta name="robots" content="noindex"/>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= t('perfil.editar_seo_titulo') %></title>
  <link rel="stylesheet" href="/css/perfil.css"/>
  <script src="/js/theme.js"></script>
</head>
<body>
<%- include('../partials/header') %>

<main class="perfil-page" id="main-content">
<div class="container perfil-wrap">
<a href="/perfil_editado" class="breadcrumb-link"><i data-lucide="arrow-left"></i> <%= t('auth.minha_conta_breadcrumb_txt') %></a>
<div class="card">
  <header class="cover">
    <section class="avatar-wrapper">
      <%# Foto de perfil entra junto com o upload de imagens (próxima etapa).
          Até lá, a inicial — sem botão que finge funcionar. %>
      <figure class="avatar-ring" aria-hidden="true">
        <section class="avatar-placeholder">
          <span id="avatarInitial"><%= (conta.name || '?').trim().charAt(0).toUpperCase() %></span>
        </section>
      </figure>
    </section>
  </header>

  <section class="body">
    <header class="preview-header">
      <h1 class="preview-name" id="previewName"><%= conta.name %></h1>
      <p class="preview-username"><%= conta.email %></p>
    </header>

    <hr class="divider">

    <!-- ============ NOME ============ -->
    <form class="profile-form" id="formNome" novalidate>
      <h2 class="section-title"><%= t('perfil.info_pessoais') %></h2>
      <article class="field">
        <label for="nome"><%= t('perfil.nome_completo') %> <span aria-hidden="true" class="required-mark">*</span></label>
        <input type="text" id="nome" name="nome" value="<%= conta.name %>" maxlength="120"
               autocomplete="name" aria-describedby="err_nome hint_nome" required/>
        <p class="field-hint" id="hint_nome"><%= t('perfil.nome_hint') %></p>
        <p class="field-error" id="err_nome" role="alert"></p>
      </article>
      <footer class="actions">
        <button class="btn-save" type="submit"><%= t('perfil.salvar_nome') %></button>
      </footer>
    </form>

    <hr class="divider">

    <!-- ============ E-MAIL ============ -->
    <form class="profile-form" id="formEmail" novalidate>
      <h2 class="section-title"><%= t('perfil.email_titulo') %></h2>
      <p class="field-hint">
        <%= t('perfil.atual') %> <strong><%= conta.email %></strong>
        <% if (conta.email_verified_at) { %>· <%= t('perfil.confirmado') %><% } else { %>· <span class="warn-text"><%= t('perfil.nao_confirmado') %></span><% } %>
      </p>
      <% if (conta.email_pendente) { %>
        <p class="notice" role="status">
          <%= t('perfil.aguardando_confirmacao') %> <strong><%= conta.email_pendente %></strong>. <%= t('perfil.abra_link') %>
        </p>
      <% } %>
      <section class="grid-2">
        <article class="field">
          <label for="novoEmail"><%= t('perfil.novo_email') %></label>
          <input type="email" id="novoEmail" name="novoEmail" autocomplete="email" maxlength="255" aria-describedby="err_novoEmail"/>
          <p class="field-error" id="err_novoEmail" role="alert"></p>
        </article>
        <article class="field">
          <label for="senhaEmail"><%= t('perfil.sua_senha') %></label>
          <input type="password" id="senhaEmail" name="senhaEmail" autocomplete="current-password" aria-describedby="err_senhaEmail"/>
          <p class="field-error" id="err_senhaEmail" role="alert"></p>
        </article>
      </section>
      <p class="field-hint">
        <%= t('perfil.email_seguranca', { horas: horasTroca }) %>
      </p>
      <footer class="actions">
        <button class="btn-save" type="submit"><%= t('perfil.enviar_confirmacao') %></button>
      </footer>
    </form>

    <hr class="divider">

    <!-- ============ SENHA ============ -->
    <form class="profile-form" id="formSenha" novalidate>
      <h2 class="section-title"><%= t('perfil.senha_titulo') %></h2>
      <article class="field">
        <label for="senhaAtual"><%= t('perfil.senha_atual') %></label>
        <input type="password" id="senhaAtual" name="senhaAtual" autocomplete="current-password" aria-describedby="err_senhaAtual"/>
        <p class="field-error" id="err_senhaAtual" role="alert"></p>
      </article>
      <section class="grid-2">
        <article class="field">
          <label for="novaSenha"><%= t('auth.nova_senha') %></label>
          <input type="password" id="novaSenha" name="novaSenha" autocomplete="new-password" minlength="8" aria-describedby="err_novaSenha"/>
          <p class="field-error" id="err_novaSenha" role="alert"></p>
        </article>
        <article class="field">
          <label for="confirmaSenha"><%= t('auth.confirme_nova_senha') %></label>
          <input type="password" id="confirmaSenha" name="confirmaSenha" autocomplete="new-password" aria-describedby="err_confirmaSenha"/>
          <p class="field-error" id="err_confirmaSenha" role="alert"></p>
        </article>
      </section>
      <p class="field-hint"><%= t('perfil.senha_sessoes') %></p>
      <footer class="actions">
        <button class="btn-save" type="submit"><%= t('perfil.trocar_senha') %></button>
      </footer>
    </form>

    <hr class="divider">
    <p class="field-hint">
      <%- t('perfil.privacidade_link_html') %>
    </p>
  </section>
</div>
</div>
</main>

<section class="toast" id="toast" role="status" aria-live="polite"></section>

<%- include('../partials/footer') %>
<script src="/js/perfil.js" defer></script>
</body>
</html>
