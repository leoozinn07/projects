<!DOCTYPE html>
<html lang="<%= locals.htmlLang || 'pt-BR' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <title><%= t('auth.conta2fa_seo_titulo') %></title>
  <link rel="stylesheet" href="/css/reservas.css">
  <link rel="stylesheet" href="/css/recuperacao.css">
  <script src="/js/theme.js"></script>
</head>
<body>
<%- include('../partials/header') %>
<main id="main-content" class="booking-main">
  <div class="container">
    <a href="/perfil_editado" class="breadcrumb-link"><%= t('auth.minha_conta_breadcrumb') %></a>
    <div class="auth-card auth-card--wide">
      <h1><%= t('auth.duas_etapas') %></h1>

      <% if (aviso === 'obrigatorio' || (obrigatorio && !status.ativo)) { %>
        <p class="form-alert form-alert-error" role="alert">
          <%= t('auth.conta2fa_obrigatorio') %>
        </p>
      <% } %>
      <% if (aviso === 'poucos-codigos') { %>
        <p class="form-alert form-alert-error" role="alert"><%= t('auth.conta2fa_poucos_codigos') %></p>
      <% } %>
      <% if (aviso === 'desativado') { %>
        <p class="form-alert form-alert-success" role="status"><%= t('auth.conta2fa_desativada') %></p>
      <% } %>
      <% if (error) { %><p class="form-alert form-alert-error" role="alert"><%= tm(error) %></p><% } %>

      <% if (codigosNovos) { %>
        <!-- Exibidos UMA vez: no banco só existe o hash. -->
        <section class="codes-box" aria-labelledby="t-codes">
          <h2 id="t-codes"><%= t('auth.guarde_codigos') %></h2>
          <p><%- t('auth.codigos_aviso_html') %></p>
          <ol class="codes-list"><% codigosNovos.forEach(function (c) { %><li><code><%= c %></code></li><% }); %></ol>
        </section>
        <a class="btn-primary" href="/perfil_editado"><%= t('auth.ja_guardei_codigos') %></a>

      <% } else if (!status.ativo) { %>
        <ol class="setup-steps">
          <li><%= t('auth.passo1_2fa') %></li>
          <li><%= t('auth.passo2_2fa') %>
            <figure class="qr"><img src="<%= config.qr %>" alt="<%= t('auth.qr_alt') %>" width="220" height="220"></figure>
            <p class="field-hint"><%= t('auth.sem_camera') %><br><code class="secret-key"><%= config.chave %></code></p>
          </li>
          <li><%= t('auth.passo3_2fa') %></li>
        </ol>
        <form action="/conta/2fa/ativar" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="codigo"><%= t('auth.codigo_app') %></label>
          <input type="text" id="codigo" name="codigo" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required class="code-input">
          <label for="senha"><%= t('auth.sua_senha') %></label>
          <input type="password" id="senha" name="senha" autocomplete="current-password" required>
          <button type="submit" class="btn-primary btn-block"><%= t('auth.ativar') %></button>
        </form>

      <% } else { %>
        <p class="form-alert form-alert-success" role="status">
          <%= t('auth.ativa_desde', { data: fmt.data(status.ativadoEm) }) %> <strong><%= status.recuperacaoRestantes %></strong>.
        </p>
        <h2 class="section-h"><%= t('auth.gerar_novos_codigos') %></h2>
        <p class="field-hint"><%= t('auth.codigos_antigos_param') %></p>
        <form action="/conta/2fa/codigos" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="c1"><%= t('auth.codigo_app') %></label>
          <input type="text" id="c1" name="codigo" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required class="code-input">
          <label for="s1"><%= t('auth.sua_senha') %></label>
          <input type="password" id="s1" name="senha" autocomplete="current-password" required>
          <button type="submit" class="btn-ghost btn-block"><%= t('auth.gerar_novos_codigos_btn') %></button>
        </form>

        <% if (!obrigatorio) { %>
          <h2 class="section-h"><%= t('auth.desativar') %></h2>
          <p class="field-hint"><%= t('auth.desativar_texto') %></p>
          <form action="/conta/2fa/desativar" method="POST" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label for="c2"><%= t('auth.codigo_app') %></label>
            <input type="text" id="c2" name="codigo" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required class="code-input">
            <label for="s2"><%= t('auth.sua_senha') %></label>
            <input type="password" id="s2" name="senha" autocomplete="current-password" required>
            <button type="submit" class="btn-ghost btn-block danger"><%= t('auth.desativar') %></button>
          </form>
        <% } else { %>
          <p class="field-hint"><%= t('auth.admin_obrigatorio') %></p>
        <% } %>
      <% } %>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
</body>
</html>
