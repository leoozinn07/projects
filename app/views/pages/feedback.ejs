<!DOCTYPE html>
<html lang="<%= locals.htmlLang || 'pt-BR' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= t('feedback.titulo') %> | AquaTrip</title>
  <link rel="stylesheet" href="/css/comunidade.css">
  <script src="/js/theme.js"></script>
</head>
<body>
<%- include('../partials/header') %>
<%
  const TIPO = { COMPLAINT: t('feedback.tipo_reclamacao'), RATING: t('feedback.tipo_avaliacao'), SUGGESTION: t('feedback.tipo_sugestao') };
  const STATUS = { OPEN: t('feedback.st_aberta'), IN_PROGRESS: t('feedback.st_andamento'), RESOLVED: t('feedback.st_resolvida'), CLOSED: t('feedback.st_encerrada') };
%>
<main id="main-content" class="wrap fb-page">
  <header class="page-head">
    <a href="/perfil_editado" class="breadcrumb-link"><i data-lucide="arrow-left"></i> <%= t('auth.minha_conta_breadcrumb_txt') %></a>
    <p class="kicker"><%= t('feedback.kicker') %></p>
    <h1 class="display h-l"><%= t('feedback.titulo') %></h1>
    <p class="lead"><%= t('feedback.lead') %></p>
  </header>

  <div class="fb-layout">
    <form class="form-card" id="fbForm" novalidate data-fk-busy="off">
      <h2><%= t('feedback.novo') %></h2>
      <div class="field" role="radiogroup" aria-labelledby="fbTipoLabel">
        <span class="label" id="fbTipoLabel"><%= t('feedback.tipo') %><span class="req" aria-hidden="true">*</span></span>
        <div class="choice-group">
          <label class="choice"><input type="radio" name="kind" value="COMPLAINT" checked><span><i data-lucide="triangle-alert"></i> <%= t('feedback.tipo_reclamacao') %></span></label>
          <label class="choice"><input type="radio" name="kind" value="SUGGESTION"><span><i data-lucide="lightbulb"></i> <%= t('feedback.tipo_sugestao') %></span></label>
          <label class="choice"><input type="radio" name="kind" value="RATING"><span><i data-lucide="star"></i> <%= t('feedback.tipo_avaliacao') %></span></label>
        </div>
      </div>
      <fieldset class="field fb-rating" id="fbNota" hidden>
        <legend class="label"><%= t('feedback.nota') %><span class="req" aria-hidden="true">*</span></legend>
        <div class="fb-stars">
          <% [5,4,3,2,1].forEach(function (n) { %>
            <input type="radio" name="rating" id="fbN<%= n %>" value="<%= n %>"><label for="fbN<%= n %>" title="<%= t('exp.n_estrelas', { n: n }) %>"><span class="sr-only"><%= t('exp.n_estrelas', { n: n }) %></span>★</label>
          <% }) %>
        </div>
        <span class="field-error" id="fbNotaErr" aria-live="polite"></span>
      </fieldset>
      <div class="field">
        <label for="fbAssunto"><%= t('feedback.assunto') %><span class="req" aria-hidden="true">*</span></label>
        <input id="fbAssunto" type="text" required minlength="4" maxlength="120" placeholder="<%= t('feedback.assunto_ph') %>" aria-describedby="fbAssuntoErr">
        <span class="field-error" id="fbAssuntoErr" aria-live="polite"></span>
      </div>
      <div class="field">
        <label for="fbMsg"><%= t('feedback.mensagem') %><span class="req" aria-hidden="true">*</span></label>
        <textarea id="fbMsg" rows="5" required minlength="10" maxlength="2000" data-counter placeholder="<%= t('feedback.mensagem_ph') %>" aria-describedby="fbMsgHelp fbMsgErr"></textarea>
        <span class="field-help" id="fbMsgHelp"><%= t('feedback.mensagem_help') %></span>
        <span class="field-error" id="fbMsgErr" aria-live="polite"></span>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn-primary btn-lg" id="fbEnviar"><span><%= t('feedback.enviar') %></span></button>
      </div>
      <p class="form-status" id="fbStatus" role="status" aria-live="polite"></p>
    </form>

    <section class="fb-hist" aria-labelledby="fbHist">
      <h2 id="fbHist" class="h-m"><%= t('feedback.meus') %></h2>
      <% if (enviado) { %><p class="form-alert form-alert-success" role="status"><%= t('feedback.enviado') %></p><% } %>
      <% if (!meus.length) { %>
        <p class="field-help"><%= t('feedback.nenhum') %></p>
      <% } else { %>
        <ul class="fb-list">
          <% meus.forEach(function (f) { %>
            <li class="fb-item">
              <p class="fb-item-head">
                <span class="cx-badge"><%= TIPO[f.kind] %></span>
                <span class="cx-badge cx-badge-<%= f.status === 'RESOLVED' ? 'approved' : f.status === 'OPEN' ? 'pending' : 'nova' %>"><%= STATUS[f.status] %></span>
                <time datetime="<%= new Date(f.created_at).toISOString() %>"><%= fmt.data(f.created_at) %></time>
              </p>
              <h3><%= f.subject %><% if (f.rating) { %> <span class="fb-item-stars" aria-label="<%= t('exp.n_estrelas', { n: f.rating }) %>"><%= '★'.repeat(f.rating) %></span><% } %></h3>
              <p class="sx-pre"><%= f.message %></p>
              <% if (f.admin_response) { %>
                <div class="fb-resp">
                  <p class="kicker"><%= t('feedback.resposta_equipe') %> · <%= fmt.data(f.responded_at) %></p>
                  <p class="sx-pre"><%= f.admin_response %></p>
                </div>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </div>
</main>
<%- include('../partials/footer') %>
<script src="/js/feedback.js" defer></script>
</body>
</html>
