<!DOCTYPE html>
<html lang="<%= locals.htmlLang || 'pt-BR' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#050d1a">
  <title><%= t('auth.verificar_seo_titulo') %></title>
  <link rel="stylesheet" href="/css/reservas.css">
  <link rel="stylesheet" href="/css/recuperacao.css">
  <script src="/js/theme.js"></script>
</head>
<body>

<%- include('../partials/header') %>

<main id="main-content" class="booking-main">
  <div class="container">
    <div class="auth-card">
      <% if (sucesso) { %>
        <% if (typeof emailTrocado !== 'undefined' && emailTrocado) { %>
          <h1><%= t('auth.email_alterado') %></h1>
          <p class="form-alert form-alert-success" role="status">
            <%= t('auth.email_alterado_texto') %> <strong><%= novoEmail %></strong>.
          </p>
        <% } else { %>
          <h1><%= t('auth.email_confirmado') %></h1>
          <p class="form-alert form-alert-success" role="status">
            <%= t('auth.email_confirmado_texto') %>
          </p>
        <% } %>
        <a class="btn-primary" href="/"><%= t('auth.ir_para_home') %></a>
      <% } else if (reenviado) { %>
        <h1><%= t('auth.link_reenviado') %></h1>
        <p class="form-alert form-alert-success" role="status">
          <%= t('auth.link_reenviado_texto') %>
        </p>
        <a class="btn-ghost" href="/"><%= t('auth.voltar') %></a>
      <% } else { %>
        <h1><%= t('auth.nao_confirmado_titulo') %></h1>
        <p class="form-alert form-alert-error" role="alert">
          <%= error ? tm(error) : t('auth.link_confirmacao_invalido') %>
        </p>
        <% if (user) { %>
          <form action="/reenviar-verificacao" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn-primary"><%= t('auth.reenviar_link') %></button>
          </form>
        <% } else { %>
          <a class="btn-ghost" href="/login"><%= t('auth.entrar_na_conta') %></a>
        <% } %>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
