<!DOCTYPE html>
<html lang="<%= locals.htmlLang || 'pt-BR' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= editar ? t('criar.titulo_editar') : t('criar.titulo') %> | AquaTrip</title>
  <link rel="stylesheet" href="/css/comunidade.css" />
  <script src="/js/theme.js"></script>
</head>
<body>
<%- include('../partials/header') %>
<%
  const cats = [['praia','sun'],['mergulho','waves'],['caiaque','sailboat'],['pesca','fish'],['expedicao','compass'],['aquario','shell']];
  const e = editar || {};
  const precoReais = e.price_cents ? (e.price_cents / 100).toFixed(2).replace('.', ',') : '';
  const bloqueada = editar && editar.moderation_status !== 'ACTIVE';
%>
<main id="main-content" class="wrap cx-page">
  <header class="page-head">
    <a href="<%= editar ? '/meu-perfil' : '/comunidade' %>" class="breadcrumb-link"><i data-lucide="arrow-left"></i> <%= editar ? t('criar.voltar_perfil') : t('criar.voltar_comunidade') %></a>
    <p class="kicker"><%= editar ? t('criar.kicker_editar') : t('criar.kicker') %></p>
    <h1 class="display h-l"><%= editar ? t('criar.titulo_editar') : t('criar.titulo') %></h1>
    <p class="lead"><%= t('criar.lead') %></p>
  </header>

  <% if (bloqueada) { %>
    <p class="form-alert form-alert-error" role="alert"><%= t('criar.moderada', { motivo: editar.moderation_reason || '' }) %></p>
  <% } %>

  <div class="cx-layout">
    <form id="cxForm" class="cx-form" novalidate
          data-id="<%= e.id || '' %>" data-slug="<%= e.slug || '' %>" data-max-fotos="<%= maxFotos %>"
          data-fotos-atuais="<%= (e.fotos || []).length %>">
      <fieldset class="form-card" <%= bloqueada ? 'disabled' : '' %>>
        <legend class="cx-step"><span class="cx-num">01</span> <%= t('criar.passo_viagem') %></legend>

        <div class="field">
          <label for="cxTitle"><%= t('criar.titulo_label') %><span class="req" aria-hidden="true">*</span></label>
          <input id="cxTitle" name="title" type="text" required minlength="6" maxlength="80" data-counter
                 value="<%= e.title || '' %>" placeholder="<%= t('criar.titulo_ph') %>" aria-describedby="cxTitleErr">
          <span class="field-error" id="cxTitleErr" aria-live="polite"></span>
        </div>

        <div class="field">
          <label for="cxDesc"><%= t('criar.desc_label') %><span class="req" aria-hidden="true">*</span></label>
          <textarea id="cxDesc" name="description" required minlength="30" maxlength="2000" data-counter rows="5"
                    placeholder="<%= t('criar.desc_ph') %>" aria-describedby="cxDescHelp cxDescErr"><%= e.description || '' %></textarea>
          <span class="field-help" id="cxDescHelp"><%= t('criar.desc_help') %></span>
          <span class="field-error" id="cxDescErr" aria-live="polite"></span>
        </div>

        <div class="field" role="radiogroup" aria-labelledby="cxCatLabel" aria-describedby="cxCatErr">
          <span class="label" id="cxCatLabel"><%= t('criar.cat_label') %><span class="req" aria-hidden="true">*</span></span>
          <div class="choice-group cx-cats">
            <% cats.forEach(function (c) { %>
              <label class="choice">
                <input type="radio" name="category" value="<%= c[0] %>" <%= e.category === c[0] ? 'checked' : '' %> required>
                <span><i data-lucide="<%= c[1] %>"></i> <%= categoriaRotulo(c[0]) %></span>
              </label>
            <% }) %>
          </div>
          <span class="field-error" id="cxCatErr" aria-live="polite"></span>
        </div>
      </fieldset>

      <fieldset class="form-card" <%= bloqueada ? 'disabled' : '' %>>
        <legend class="cx-step"><span class="cx-num">02</span> <%= t('criar.passo_quando') %></legend>
        <div class="field">
          <label for="cxLoc"><%= t('criar.destino_label') %><span class="req" aria-hidden="true">*</span></label>
          <input id="cxLoc" name="location" type="text" required minlength="3" maxlength="100" autocomplete="off"
                 value="<%= e.location || '' %>" placeholder="<%= t('criar.destino_ph') %>" aria-describedby="cxLocErr">
          <span class="field-error" id="cxLocErr" aria-live="polite"></span>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="cxDate"><%= t('criar.data_label') %><span class="req" aria-hidden="true">*</span></label>
            <input id="cxDate" name="date" type="date" required value="<%= e.data || '' %>" aria-describedby="cxDateErr">
            <span class="field-error" id="cxDateErr" aria-live="polite"></span>
          </div>
          <div class="field">
            <label for="cxTime"><%= t('criar.hora_label') %><span class="req" aria-hidden="true">*</span></label>
            <input id="cxTime" name="time" type="time" required value="<%= e.hora || '' %>" aria-describedby="cxTimeHelp cxTimeErr">
            <span class="field-help" id="cxTimeHelp"><%= t('criar.hora_help') %></span>
            <span class="field-error" id="cxTimeErr" aria-live="polite"></span>
          </div>
        </div>
      </fieldset>

      <fieldset class="form-card" <%= bloqueada ? 'disabled' : '' %>>
        <legend class="cx-step"><span class="cx-num">03</span> <%= t('criar.passo_vagas') %></legend>
        <div class="field-row">
          <div class="field">
            <label for="cxCap"><%= t('criar.vagas_label') %><span class="req" aria-hidden="true">*</span></label>
            <input id="cxCap" name="capacity" type="number" inputmode="numeric" required min="1" max="100" step="1"
                   value="<%= e.capacity || '' %>" placeholder="4" aria-describedby="cxCapHelp cxCapErr">
            <span class="field-help" id="cxCapHelp"><%= t('criar.vagas_help') %></span>
            <span class="field-error" id="cxCapErr" aria-live="polite"></span>
          </div>
          <div class="field">
            <label for="cxPreco"><%= t('criar.preco_label') %><span class="opt"><%= t('criar.preco_opt') %></span></label>
            <input id="cxPreco" name="preco" type="text" inputmode="decimal" autocomplete="off" pattern="^[0-9.]*(,[0-9]{1,2})?$"
                   value="<%= precoReais %>" placeholder="0,00" aria-describedby="cxPrecoHelp cxPrecoErr">
            <span class="field-help" id="cxPrecoHelp"><%= t('criar.preco_help') %></span>
            <span class="field-error" id="cxPrecoErr" aria-live="polite"></span>
          </div>
        </div>
        <% if (!podeCobrar) { %>
          <aside class="cx-note" id="cxNotePreco">
            <i data-lucide="hand-coins" aria-hidden="true"></i>
            <p><%- t('criar.cobrar_html') %></p>
          </aside>
        <% } %>
      </fieldset>

      <fieldset class="form-card" <%= bloqueada ? 'disabled' : '' %>>
        <legend class="cx-step"><span class="cx-num">04</span> <%= t('criar.passo_info') %> <span class="opt"><%= t('criar.opcional') %></span></legend>
        <div class="field">
          <label for="cxInfo"><%= t('criar.info_label') %></label>
          <textarea id="cxInfo" name="tripInfo" maxlength="2000" data-counter rows="4"
                    placeholder="<%= t('criar.info_ph') %>" aria-describedby="cxInfoErr"><%= e.trip_info || '' %></textarea>
          <span class="field-error" id="cxInfoErr" aria-live="polite"></span>
        </div>
      </fieldset>

      <fieldset class="form-card" <%= bloqueada ? 'disabled' : '' %>>
        <legend class="cx-step"><span class="cx-num">05</span> <%= t('criar.passo_fotos') %> <span class="opt"><%= t('criar.opcional') %></span></legend>
        <label class="cx-drop" for="cxFotos">
          <input id="cxFotos" type="file" accept="image/jpeg,image/png,image/webp" multiple class="sr-only" aria-describedby="cxFotosHelp">
          <i data-lucide="image-plus" aria-hidden="true"></i>
          <strong><%= t('criar.fotos_cta') %></strong>
          <span id="cxFotosHelp"><%= t('criar.fotos_help', { n: maxFotos }) %></span>
        </label>
        <ul class="cx-thumbs" id="cxThumbs" aria-label="<%= t('criar.fotos_lista') %>">
          <% (e.fotos || []).forEach(function (f) { %>
            <li class="cx-thumb" data-media="<%= f.id %>">
              <img src="<%= f.url %>" alt="" loading="lazy">
              <span class="cx-badge cx-badge-<%= f.status.toLowerCase() %>"><%= t('criar.foto_' + f.status.toLowerCase()) %></span>
              <button type="button" class="icon-btn cx-thumb-del" data-remover="<%= f.id %>" aria-label="<%= t('criar.foto_remover') %>"><i data-lucide="x"></i></button>
            </li>
          <% }) %>
        </ul>
        <p class="field-help"><i data-lucide="shield-check" class="cx-inline-ico" aria-hidden="true"></i> <%= t('criar.fotos_moderacao') %></p>
      </fieldset>

      <footer class="cx-actions">
        <p class="form-status" id="cxStatus" role="status" aria-live="polite"></p>
        <div class="form-actions">
          <% if (editar) { %>
            <a class="btn-ghost btn-lg" href="/reservar/<%= encodeURIComponent(e.slug) %>"><%= t('criar.ver_pagina') %></a>
          <% } %>
          <button type="submit" class="btn-primary btn-lg" id="cxSubmit" <%= bloqueada ? 'disabled' : '' %>>
            <span><%= editar ? t('criar.salvar') : t('criar.publicar') %></span> <i data-lucide="arrow-right" class="arrow"></i>
          </button>
        </div>
      </footer>
    </form>

    <aside class="cx-preview" aria-label="<%= t('criar.previa') %>">
      <p class="kicker"><%= t('criar.previa') %></p>
      <article class="cc-card" aria-hidden="true">
        <figure class="cc-media"><img id="pvImg" src="/img/praia.webp" alt=""><span class="cc-price" id="pvPreco"><%= t('comunidade.gratuita') %></span></figure>
        <div class="cc-body">
          <p class="cc-loc"><i data-lucide="map-pin"></i> <span id="pvLoc"><%= t('criar.destino_ph') %></span></p>
          <h3 class="cc-title" id="pvTitle"><%= t('criar.titulo_ph') %></h3>
          <p class="cc-meta"><span><i data-lucide="calendar"></i> <span id="pvData">--</span></span><span><i data-lucide="users"></i> <span id="pvVagas">--</span></span></p>
        </div>
      </article>
      <% if (editar) { %>
        <section class="cx-manage">
          <h2 class="h-m"><%= t('criar.gerenciar') %></h2>
          <button type="button" class="btn-ghost btn-block" id="cxToggle" data-publicada="<%= e.active ? '1' : '0' %>" <%= bloqueada ? 'disabled' : '' %>>
            <%= e.active ? t('criar.pausar') : t('criar.republicar') %>
          </button>
          <div class="cx-people" id="cxPeople" data-id="<%= e.id %>">
            <p class="field-help"><%= t('criar.carregando_pessoas') %></p>
          </div>
        </section>
      <% } %>
    </aside>
  </div>
</main>

<dialog class="cx-dialog" id="cxDone" aria-labelledby="cxDoneTitle">
  <div class="cx-dialog-body">
    <span class="cx-dialog-ico" aria-hidden="true"><i data-lucide="party-popper"></i></span>
    <h2 id="cxDoneTitle"><%= t('criar.pronto_titulo') %></h2>
    <p id="cxDoneText"><%= t('criar.pronto_texto') %></p>
    <div class="form-actions">
      <a class="btn-primary" id="cxDoneVer" href="/comunidade"><%= t('criar.ver_pagina') %></a>
      <a class="btn-ghost" href="/meu-perfil"><%= t('criar.ir_perfil') %></a>
    </div>
  </div>
</dialog>

<%- include('../partials/footer') %>
<script src="/js/criar.js" defer></script>
</body>
</html>
