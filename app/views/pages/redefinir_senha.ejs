<!DOCTYPE html>
<html lang="<%= locals.htmlLang || 'pt-BR' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#050d1a">
  <meta name="robots" content="noindex">
  <title><%= t('auth.redefinir_seo_titulo') %></title>
  <link rel="stylesheet" href="/css/reservas.css">
  <link rel="stylesheet" href="/css/recuperacao.css">
  <script src="/js/theme.js"></script>
</head>
<body>

<%- include('../partials/header') %>

<main id="main-content" class="booking-main">
  <div class="container">
    <div class="auth-card">
      <% if (!tokenValido) { %>
        <h1><%= t('auth.link_invalido') %></h1>
        <p class="form-alert form-alert-error" role="alert">
          <%= error ? tm(error) : t('auth.link_redefinicao_invalido') %>
        </p>
        <p class="booking-sub">
          <%= t('auth.redefinir_validade') %>
        </p>
        <a class="btn-primary" href="/esqueci-senha"><%= t('auth.pedir_novo_link') %></a>
      <% } else { %>
        <h1><%= t('auth.criar_nova_senha') %></h1>
        <p class="booking-sub"><%= t('auth.escolha_senha') %></p>

        <% if (error) { %>
          <p class="form-alert form-alert-error" role="alert"><%= tm(error) %></p>
        <% } %>

        <form action="/redefinir-senha/<%= token %>" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <label for="senha"><%= t('auth.nova_senha') %></label>
          <input type="password" id="senha" name="senha" required minlength="8"
                 autocomplete="new-password">

          <label for="confirma-senha"><%= t('auth.confirme_nova_senha') %></label>
          <input type="password" id="confirma-senha" name="confirma-senha" required
                 minlength="8" autocomplete="new-password">

          <button type="submit" class="btn-primary btn-block"><%= t('auth.salvar_nova_senha') %></button>
        </form>

        <p class="auth-note">
          <%= t('auth.sessoes_encerradas') %>
        </p>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
