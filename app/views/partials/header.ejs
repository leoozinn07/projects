    <%# Botão de menu do celular: duas linhas que viram um X %>
    <button id="hamburgerBtn" class="menu-toggle hamburger-btn" type="button" aria-label="<%= t('nav.abrir_menu') %>" data-label-open="<%= t('nav.abrir_menu') %>" data-label-close="<%= t('nav.fechar_menu') %>" aria-expanded="false" aria-controls="appDrawer">
      <span class="menu-toggle-lines" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<!-- BACKDROP compartilhado (sheets) -->
