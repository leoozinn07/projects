        <li><a href="/caiaque"><i data-lucide="sailboat"></i> <%= t('cats.caiaque') %></a></li>
        <li><a href="/pesca"><i data-lucide="fish"></i> <%= t('cats.pesca') %></a></li>
        <li><a href="/expedicoes"><i data-lucide="compass"></i> <%= t('cats.expedicoes') %></a></li>
