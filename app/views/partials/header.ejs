<%# Idioma: se a view foi desenhada sem o middleware de idioma (página de
    erro de um app sem locais), usa o português padrão. `var` porque o EJS
    resolve nomes pelo objeto de locais primeiro e só depois por aqui. %>
<%
  var _i18n = (typeof __aquatripI18n !== 'undefined' && __aquatripI18n) || {};
  var t = locals.t || _i18n.t || function (k) { return k; };
  var tm = locals.tm || _i18n.tm || function (m) { return m; };
  var lang = locals.lang || _i18n.lang || 'pt';
  var idiomas = locals.idiomas || _i18n.idiomas || [];
  var i18nCliente = locals.i18nCliente || _i18n.i18nCliente || '{}';
%>
<%# `user` pode não existir: a página de erro é desenhada antes dos
    middlewares que preenchem os locais (ex.: falha do banco). %>
<%
  const u = locals.user || null;
  const csrf = locals.csrfToken || '';
  const caminho = (locals.seo && locals.seo.canonica) ? String(locals.seo.canonica).replace(/^https?:\/\/[^/]+/, '') : '';
  const atual = function (href) { return caminho === href || (href !== '/' && caminho.indexOf(href + '/') === 0) ? ' aria-current="page"' : ''; };
  const categorias = ['/praias', '/mergulho', '/caiaque', '/pesca', '/expedicoes', '/aquarios'];
  const emDestinos = caminho === '/reservar' || caminho.indexOf('/reservar/') === 0 || categorias.indexOf(caminho) > -1;
  const primeiroNome = u && u.name ? u.name.trim().split(' ')[0] : '';
  // Aba ativa do dock: 0 início, 1 explorar, 2 reservas, 3 conta
  const contaRotas = ['/perfil', '/perfil_editado', '/configuracoes', '/conta', '/ingressos', '/viagens', '/login', '/cadastro'];
  let abaDock = -1;
  if (caminho === '/' || caminho === '') abaDock = 0;
  else if (emDestinos) abaDock = 1;
  else if (caminho.indexOf('/minhas-reservas') === 0 || caminho.indexOf('/reservas/') === 0 || caminho.indexOf('/avaliacao') === 0) abaDock = 2;
  else if (contaRotas.some(function (r) { return caminho === r || caminho.indexOf(r + '/') === 0; })) abaDock = 3;
  // Telas de tarefa (entrar, pagar) ficam sem o dock para não competir com o botão principal
  const semDock = ['/login', '/cadastro', '/esqueci-senha', '/redefinir-senha', '/verificar-email', '/aceite-termos'].some(function (r) { return caminho.indexOf(r) === 0; }) || /^\/reservas\/[^/]+\/checkout/.test(caminho);
%>
