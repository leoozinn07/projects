    </nav>

    <div class="app-header-spacer"></div>

    <button class="header-search-inline" type="button" data-open-search aria-label="<%= t('nav.buscar_aria') %>">
      <i data-lucide="search"></i>
      <span><%= t('nav.buscar') %></span>
      <kbd aria-hidden="true">/</kbd>
    </button>

    <button class="icon-btn search-trigger-mobile" type="button" data-open-search aria-label="<%= t('nav.buscar_aria') %>">
      <i data-lucide="search"></i>
    </button>

    <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="<%= t('client.tema_para_escuro') %>">
