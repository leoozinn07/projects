            <a href="/meu-perfil"><i data-lucide="circle-user-round"></i> <%= t('comunidade.meu_perfil') %></a>
            <a href="/criar_experiencia"><i data-lucide="circle-plus"></i> <%= t('comunidade.criar') %></a>
            <a href="/perfil_editado"><i data-lucide="user-round"></i> <%= t('conta.minha_conta') %></a>
            <a href="/minhas-reservas"><i data-lucide="calendar-check"></i> <%= t('conta.minhas_reservas') %></a>
            <a href="/ingressos"><i data-lucide="ticket"></i> <%= t('conta.ingressos') %></a>
            <a href="/viagens"><i data-lucide="map"></i> <%= t('conta.diario') %></a>
            <a href="/configuracoes"><i data-lucide="settings-2"></i> <%= t('conta.configuracoes') %></a>
            <a href="/feedback"><i data-lucide="message-square-warning"></i> <%= t('comunidade.feedback_link') %></a>
            <% if (u.role === 'ADMIN') { %>
              <a href="/admin"><i data-lucide="settings"></i> <%= t('conta.painel_admin') %></a>
              <a href="/admin/auditoria"><i data-lucide="scroll-text"></i> <%= t('conta.auditoria') %></a>
            <% } %>
            <form action="/logout" method="POST" class="logout-form">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button type="submit"><i data-lucide="log-out"></i> <%= t('conta.sair') %></button>
            </form>
          </div>
        </div>
      <% } %>
