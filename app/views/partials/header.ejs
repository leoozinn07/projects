<!-- BUSCA -->
<div id="searchOverlay" class="search-overlay" role="dialog" aria-modal="true" aria-label="<%= t('nav.buscar') %>" hidden>
  <form class="search-overlay-head" action="/reservar" method="GET" role="search">
    <div class="search-field" id="searchOverlayField">
      <i data-lucide="search"></i>
      <label for="searchOverlayInput" class="sr-only"><%= t('busca.rotulo') %></label>
      <input id="searchOverlayInput" name="q" type="search" placeholder="<%= t('busca.placeholder') %>" autocomplete="off" enterkeyhint="search" />
      <button id="searchClearBtn" class="search-clear-btn" type="button" aria-label="<%= t('busca.limpar') %>">
        <i data-lucide="x"></i>
      </button>
    </div>
    <button id="searchCloseBtn" class="btn-secondary" type="button"><%= t('busca.cancelar') %></button>
  </form>
  <div class="search-overlay-body">
    <div id="searchDefaultWrap">
      <div id="searchRecentWrap" hidden>
        <p class="search-section-title"><%= t('busca.recentes') %></p>
        <ul class="search-recent-list" id="searchRecentList"></ul>
      </div>
      <p class="search-section-title"><%= t('busca.sugestoes') %></p>
      <div class="search-suggest-chip-row">
        <a class="search-suggest-chip" href="/praias"><%= t('cats.praias') %></a>
        <a class="search-suggest-chip" href="/mergulho"><%= t('cats.mergulho') %></a>
        <a class="search-suggest-chip" href="/caiaque"><%= t('cats.caiaque') %></a>
        <a class="search-suggest-chip" href="/pesca"><%= t('cats.pesca') %></a>
        <a class="search-suggest-chip" href="/expedicoes"><%= t('cats.expedicoes') %></a>
        <a class="search-suggest-chip" href="/aquarios"><%= t('cats.aquarios') %></a>
      </div>
    </div>
    <div id="searchResultsWrap" hidden>
      <p class="search-section-title"><%= t('busca.resultados') %></p>
      <ul class="search-results-list" id="searchResultsList"></ul>
      <a class="link-arrow" id="searchSeeAll" href="/reservar"><%= t('busca.ver_todos') %> <i data-lucide="arrow-right"></i></a>
    </div>
    <p id="searchEmptyState" class="search-empty" hidden><%= t('busca.vazio') %></p>
  </div>
</div>

<% if (!semDock) { %>
<!-- DOCK (celular): quatro destinos, indicador desliza até a aba ativa -->
<nav id="bottomNav" class="bottom-nav" aria-label="<%= t('dock.rotulo') %>" data-active="<%= abaDock %>" style="--i:<%= Math.max(abaDock, 0) %>">
  <span class="bottom-nav-pill" aria-hidden="true"></span>
  <a href="/"<%- abaDock === 0 ? ' aria-current="page"' : '' %>><i data-lucide="house"></i><span><%= t('dock.inicio') %></span></a>
  <a href="/reservar"<%- abaDock === 1 ? ' aria-current="page"' : '' %>><i data-lucide="compass"></i><span><%= t('dock.explorar') %></span></a>
  <a href="<%= u ? '/minhas-reservas' : '/login?redirect=%2Fminhas-reservas' %>"<%- abaDock === 2 ? ' aria-current="page"' : '' %>><i data-lucide="calendar-check"></i><span><%= t('dock.reservas') %></span></a>
  <a href="<%= u ? '/perfil_editado' : '/login' %>"<%- abaDock === 3 ? ' aria-current="page"' : '' %>>
    <% if (u) { %><span class="avatar-mini" aria-hidden="true"><%= primeiroNome.charAt(0).toUpperCase() %></span><span><%= t('dock.conta') %></span>
    <% } else { %><i data-lucide="user-round"></i><span><%= t('dock.entrar') %></span><% } %>
  </a>
</nav>
<% } %>

