  <button class="aq-bot-fab" id="aqBotFab" type="button" aria-expanded="false" aria-controls="aqBotPanel" aria-label="<%= t('assistente.abrir') %>">
    <img src="/img/logo-mark-light.svg" alt="" width="30" height="30">
