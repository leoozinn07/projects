      Animação 100% CSS; welcome.js só remove o elemento e permite pular. %>
  <div class="welcome" id="welcome" role="status" aria-live="polite">
    <div class="welcome-copy">
      <p class="kicker"><%= t('welcome.kicker') %></p>
      <p class="welcome-title"><%= t('welcome.titulo', { nome: boasVindas }) %></p>
      <p class="welcome-sub"><%= t('welcome.sub') %></p>
    </div>
    <div class="welcome-wave" aria-hidden="true">
      <svg class="welcome-crest" viewBox="0 0 1440 160" preserveAspectRatio="none"><path d="M0 80 C 180 20 360 20 540 80 S 900 140 1080 80 S 1440 20 1440 20 L1440 160 L0 160 Z"/></svg>
      <svg class="welcome-crest welcome-crest--back" viewBox="0 0 1440 160" preserveAspectRatio="none"><path d="M0 60 C 240 120 480 120 720 60 S 1200 0 1440 60 L1440 160 L0 160 Z"/></svg>
    </div>
    <button type="button" class="welcome-skip" id="welcomeSkip"><%= t('welcome.pular') %></button>
  </div>
  <script src="/js/welcome.js" defer></script>
<% } %>

<% if (locals.pedirAceite) { %>
  <%# Aceite obrigatório da versão vigente dos Termos e da Política %>
  <div class="terms-gate" role="dialog" aria-modal="true" aria-labelledby="tgTitle" aria-describedby="tgText">
    <div class="terms-card">
      <h2 id="tgTitle"><%= t('termos_gate.titulo') %></h2>
      <p id="tgText"><%= t('termos_gate.texto', { versao: versaoTermos }) %></p>
      <form action="/aceite-termos" method="POST" class="terms-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="redirect" value="<%= caminho || '/' %>">
        <label class="check-row" for="tgAceite">
          <input type="checkbox" id="tgAceite" name="aceite" required>
          <span><%- t('termos_gate.aceite_html') %></span>
        </label>
        <button type="submit" class="btn-primary btn-lg btn-block"><%= t('termos_gate.continuar') %></button>
      </form>
      <form action="/logout" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button type="submit" class="btn-secondary btn-block"><%= t('termos_gate.sair') %></button>
      </form>
    </div>
  </div>
<% } %>

