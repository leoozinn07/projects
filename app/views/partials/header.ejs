  <section class="aq-bot-panel" id="aqBotPanel" role="dialog" aria-labelledby="aqBotTitle" hidden>
    <header class="aq-bot-head">
      <img src="/img/logo-mark-light.svg" alt="" width="36" height="36">
      <div>
        <h2 id="aqBotTitle"><%= t('assistente.titulo') %></h2>
        <p id="aqBotSub"><%= t('assistente.sub') %></p>
      </div>
      <button class="icon-btn" type="button" id="aqBotClear" aria-label="<%= t('assistente.limpar') %>" title="<%= t('assistente.limpar') %>"><i data-lucide="rotate-ccw"></i></button>
      <button class="icon-btn" type="button" id="aqBotClose" aria-label="<%= t('assistente.fechar') %>"><i data-lucide="x"></i></button>
    </header>
    <ol class="aq-bot-log" id="aqBotLog" aria-live="polite" aria-relevant="additions">
      <li class="aq-msg aq-msg-bot"><p><%= t('assistente.boas_vindas') %></p></li>
    </ol>
    <div class="aq-bot-sugs" id="aqBotSugs">
      <button type="button" class="aq-sug"><%= t('assistente.sug1') %></button>
      <button type="button" class="aq-sug"><%= t('assistente.sug2') %></button>
      <button type="button" class="aq-sug"><%= t('assistente.sug3') %></button>
    </div>
    <form class="aq-bot-form" id="aqBotForm" data-fk-busy="off" data-fk-off>
      <label for="aqBotInput" class="sr-only"><%= t('assistente.campo') %></label>
      <textarea id="aqBotInput" rows="1" maxlength="800" placeholder="<%= t('assistente.placeholder') %>" enterkeyhint="send"></textarea>
      <button type="submit" class="aq-bot-send" id="aqBotSend" aria-label="<%= t('assistente.enviar') %>"><i data-lucide="arrow-up"></i></button>
    </form>
    <p class="aq-bot-note"><%= t('assistente.aviso') %></p>
  </section>
</div>
<script src="/js/assistente.js" defer></script>
<% } %>

