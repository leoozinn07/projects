        </label>
      </div>
      <div class="cmp-option-row">
        <div>
          <h3><%= t('cmp.analise') %></h3>
          <p><%= t('cmp.analise_txt') %></p>
        </div>
        <label class="switch">
          <input id="cmpAnalyticsToggle" type="checkbox" aria-label="<%= t('cmp.analise') %>" />
          <span class="switch-track"></span>
        </label>
      </div>
      <div class="cmp-option-row">
        <div>
          <h3><%= t('cmp.marketing') %></h3>
          <p><%= t('cmp.marketing_txt') %></p>
        </div>
        <label class="switch">
