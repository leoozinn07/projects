        <ul class="drawer-list">
          <li><a href="/meu-perfil"><i data-lucide="circle-user-round"></i> <%= t('comunidade.meu_perfil') %></a></li>
          <li><a href="/criar_experiencia"><i data-lucide="circle-plus"></i> <%= t('comunidade.criar') %></a></li>
          <li><a href="/perfil_editado"><i data-lucide="user-round"></i> <%= t('conta.minha_conta') %></a></li>
          <li><a href="/minhas-reservas"><i data-lucide="calendar-check"></i> <%= t('conta.minhas_reservas') %></a></li>
          <li><a href="/ingressos"><i data-lucide="ticket"></i> <%= t('conta.ingressos') %></a></li>
