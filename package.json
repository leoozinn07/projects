{
  "name": "aquatrip",
  "version": "1.0.0",
  "description": "AquaTrip - Experiências pelo Brasil",
  "main": "server.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/doctor.js",
    "db:create": "node scripts/db-create.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "db:seed:services": "node database/seed_services.js",
    "pagamentos:verificar": "node scripts/verificar-pagamentos.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "db:migrate:test": "node database/migrate-test.js",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "db:verificar-restore": "bash scripts/verificar-restore.sh",
    "pagamentos:reconciliar": "node scripts/reconciliar-pagamentos.js",
    "2fa:redefinir": "node scripts/redefinir-2fa.js",
    "db:seed:demo": "node database/seed_demo.js",
    "db:seed:comunidade": "node database/seed_comunidade.js",
    "db:seed:comunidade:limpar": "node database/seed_comunidade.js --limpar"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.0",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "lenis": "^1.3.26",
    "lucide": "^1.47.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "otplib": "^12.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  }
}
