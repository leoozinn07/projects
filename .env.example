# AquaTrip — variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA commitar o arquivo ".env" real (já está no .gitignore).

PORT=3000
NODE_ENV=development

# MySQL 8.0. Se usar o docker-compose.yml incluso, estes valores já batem.
# Rodando local sem Docker: mesmo formato, trocando host/porta/senha pelos
# do seu MySQL Workbench (padrão: 127.0.0.1:3306).
DATABASE_URL=mysql://aquatrip:aquatrip_dev_pw@localhost:3306/aquatrip

# Gere um valor forte e único por ambiente, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Trocar este valor invalida todas as sessões ativas.
SESSION_SECRET=troque-este-valor-por-um-segredo-forte-e-unico

# Credenciais do primeiro usuário admin (usadas só pelo `npm run db:seed`).
# Depois do seed, é seguro remover/trocar estas duas linhas.
ADMIN_NAME=Administrador AquaTrip
ADMIN_EMAIL=admin@aquatrip.local
ADMIN_PASSWORD=troque-esta-senha-antes-do-seed

# ==============================================================
# PAGAMENTOS
# ==============================================================
# Qual gateway usar: 'mock' (simulador) | 'mercadopago'. Vazio = mock.
# Este projeto é um checkout de TESTE: nenhum valor real é cobrado.
# O gateway real só entra com PAYMENT_PROVIDER=mercadopago escrito aqui.
# O provider 'mock' é BLOQUEADO quando NODE_ENV=production.
PAYMENT_PROVIDER=

# Ambiente do gateway — separa claramente teste de produção.
# 'sandbox' exige token TEST-...; 'production' recusa token TEST-.
PAYMENT_ENV=sandbox

# Credenciais do Mercado Pago (NUNCA commitar as reais).
# Sandbox: https://www.mercadopago.com.br/developers/panel/app
# Use o Access Token de TESTE (começa com TEST-).
MP_ACCESS_TOKEN=
# Public Key (mesma tela das credenciais; começa com TEST- no sandbox).
# Não é segredo: vai para o navegador montar o formulário de cartão.
# Sem ela, o checkout desativa o cartão e mantém só o PIX.
MP_PUBLIC_KEY=
# Segredo da assinatura de webhook, configurado no painel do MP.
MP_WEBHOOK_SECRET=

# Segredo do webhook do provider simulado (só dev).
PAYMENT_WEBHOOK_SECRET=dev-mock-secret

# URL pública da aplicação — usada como notification_url do gateway.
# Em dev, use um túnel (ex.: ngrok) para o webhook chegar até você.
PUBLIC_BASE_URL=http://localhost:3000

# Minutos que uma reserva pendente segura a vaga antes de expirar.
BOOKING_HOLD_MINUTES=15

# ==============================================================
# E-MAIL E RECUPERAÇÃO DE CONTA
# ==============================================================
# dev  = grava os e-mails em ./tmp/emails (nada é enviado de verdade)
# smtp = envia mesmo (exige: npm install nodemailer)
MAIL_TRANSPORT=dev
MAIL_FROM=AquaTrip <nao-responda@aquatrip.local>

# Só necessários com MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Validade dos links
PASSWORD_RESET_EXPIRES_MINUTES=30
EMAIL_VERIFY_EXPIRES_HOURS=48
# Máximo de pedidos de redefinição por conta, por hora
PASSWORD_RESET_MAX_PER_HOUR=5

# ==============================================================
# PRIVACIDADE / LGPD
# ==============================================================
# Versão do texto de privacidade. Ao publicar uma política nova,
# incremente: quem consentiu com a versão antiga volta a ver o
# banner, porque consentiu com outro texto.
PRIVACY_POLICY_VERSION=1.0
LEGAL_UPDATED_AT=20 de setembro de 2026
# Contato do Encarregado (DPO), exibido na política.
DPO_CONTACT=privacidade@aquatrip.local

# ==============================================================
# OBSERVABILIDADE E BACKUP
# ==============================================================
# trace | debug | info | warn | error | fatal
# Padrão: debug em dev, info em produção, silent em teste.
LOG_LEVEL=
# Onde o backup grava e quantos manter (rotação).
BACKUP_DIR=./backups
BACKUP_KEEP=14

# ==============================================================
# PAINEL ADMINISTRATIVO
# ==============================================================
# Percentual da plataforma sobre pagamentos aprovados (exibição).
PLATFORM_FEE_PERCENT=10
# Fuso em que horários são digitados e exibidos. Banco e servidor
# podem (e devem) rodar em UTC: a conversão é explícita no código.
OPERATION_TIMEZONE=America/Sao_Paulo
# Para onde vão os avisos de novas mensagens do formulário de contato
# (captação de parceiros). Vazio = só fica no painel de Atendimento.
CONTACT_INBOX=

# ==============================================================
# UPLOAD DE IMAGENS
# ==============================================================
# Pasta FORA de app/public: as imagens são entregues por /media/:chave.
# Em produção com mais de uma instância, troque o armazenamento local
# por um storage de objetos (S3, R2, GCS) — ver app/services/mediaService.js.
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880

# ==============================================================
# VERIFICAÇÃO EM DUAS ETAPAS (2FA)
# ==============================================================
# Chave que cifra os segredos TOTP no banco (AES-256-GCM). 32 bytes em
# base64. OBRIGATÓRIA em produção. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde num cofre: se ela for perdida, todo mundo precisa reconfigurar o 2FA.
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=AquaTrip
# 2FA obrigatório para administradores. Só "false" desliga (use apenas em teste).
REQUIRE_ADMIN_2FA=true

# ==============================================================
# MARKETPLACE — conexão dos parceiros com o Mercado Pago (OAuth)
# ==============================================================
# Credenciais da APLICAÇÃO do AquaTrip no painel de desenvolvedores do
# Mercado Pago (não confundir com o MP_ACCESS_TOKEN da conta).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Id da conta do Mercado Pago do próprio AquaTrip. Se um parceiro tentar
# conectar ESTA conta, é recusado (o dinheiro dele voltaria para a plataforma).
MP_PLATFORM_USER_ID=
# Comissão padrão de novos parceiros (%). Ajustável por parceiro no painel.
PARTNER_COMMISSION_PCT=15
